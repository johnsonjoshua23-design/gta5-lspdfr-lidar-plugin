<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>LspdfrLidarPlugin</RootNamespace>
    <AssemblyName>LspdfrLidarPlugin</AssemblyName>
    <Platforms>x64</Platforms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RagePluginHook">
      <HintPath>$(RAGEPLUGINHOOK_PATH)\RagePluginHook.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <Reference Include="LSPD First Response">
      <HintPath>$(LSPDFR_PATH)\LSPD First Response.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
